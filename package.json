{
  "name": "akari-root",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter @akari/web dev",
    "dev:server": "pnpm --filter @akari/server dev",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev\"",
    "build": "pnpm --filter @akari/web build",
    "build:server": "pnpm --filter @akari/server build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .prettierignore",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
